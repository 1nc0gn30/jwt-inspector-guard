[Desktop Entry]
Version=1.0
Type=Application
Name=JWT Inspector Guard
GenericName=Cryptographic JWT Security Auditor
Comment=Zero-egress JWT decoder, HS256/384/512 & RS256/ES256 JWK verifier, RFC 9449 ECDSA P-256 DPoP studio, CVE linter, and 11-tool MCP server.
Exec=/usr/local/bin/jwt-inspector-guard serve --open
TryExec=/usr/local/bin/jwt-inspector-guard
Icon=jwt-inspector-guard
Terminal=false
Categories=X-Zoth-Security;Security;Development;Utility;
StartupNotify=true
Actions=TUI;WebApp;

[Desktop Action TUI]
Name=Launch JWT Inspector Guard Braille TUI
Exec=/usr/local/bin/zoth-konsole --title "JWT Inspector Guard TUI" -- /usr/local/bin/jwt-inspector-guard-tui

[Desktop Action WebApp]
Name=Open Local Web Workstation (:8124)
Exec=xdg-open http://127.0.0.1:8124
