#!/usr/bin/env python3
"""Canonical portable ZothOS CLI wrapper for JWT Inspector Guard v2.6.0.

Resolves the runtime from $HOME/NullAITech/jwt-inspector-guard or /opt/jwt-inspector-guard
without overriding the caller's working directory (preserving relative file arguments).
Delegates --status to the live 127.0.0.1:8124/health probe and redacts home paths to ~/.
"""

from __future__ import annotations

import json
import os
import sys
import urllib.request
from pathlib import Path
from typing import Optional

VERSION = "2.6.0"
DEFAULT_PORT = int(os.environ.get("JWT_GUARD_PORT", os.environ.get("PORT", "8124")))


def _redact_home(path_str: str) -> str:
    home = os.path.expanduser("~")
    if home and path_str.startswith(home):
        return "~" + path_str[len(home):]
    return path_str


def _resolve_install_root() -> Optional[Path]:
    env_override = os.environ.get("JWT_INSPECTOR_GUARD_HOME")
    candidates = []
    if env_override:
        candidates.append(Path(env_override).expanduser())
    candidates.extend([
        Path(os.path.expanduser("~")) / "NullAITech" / "jwt-inspector-guard",
        Path("/opt/jwt-inspector-guard"),
        Path(__file__).resolve().parent.parent,
    ])
    for cand in candidates:
        if (cand / "src" / "jwt_inspector_guard" / "cli.py").is_file():
            return cand
    return None


def _probe_health(port: int = DEFAULT_PORT) -> dict:
    url = f"http://127.0.0.1:{port}/health"
    out = {
        "tool": "jwt-inspector-guard",
        "version": VERSION,
        "url": url,
        "online": False,
    }
    try:
        with urllib.request.urlopen(url, timeout=1.5) as resp:  # noqa: S310
            out["online"] = resp.status == 200
            out["health"] = json.loads(resp.read().decode("utf-8") or "{}")
    except Exception as exc:
        out["error"] = str(exc)
    return out


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    root = _resolve_install_root()
    if root is None:
        print(
            "Error: jwt-inspector-guard runtime not found in ~/NullAITech/jwt-inspector-guard or /opt/jwt-inspector-guard.",
            file=sys.stderr,
        )
        return 1

    src_dir = str(root / "src")
    if src_dir not in sys.path:
        sys.path.insert(0, src_dir)

    # Top-level --status probes real loopback :8124/health
    if args == ["--status"]:
        status = _probe_health()
        status["install_root"] = _redact_home(str(root))
        print(json.dumps(status, indent=2))
        return 0

    # Top-level --json returns redacted diagnostics + runtime metadata
    if args == ["--json"]:
        from jwt_inspector_guard.mcp_server import get_diagnostics

        diag = get_diagnostics()
        diag["install_root"] = _redact_home(str(root))
        diag["daemon"] = _probe_health()
        print(json.dumps(diag, indent=2))
        return 0

    # desktop/web convenience aliases -> unified hardened ui_server
    if args and args[0] in ("desktop", "web"):
        from jwt_inspector_guard.ui_server import run_server

        run_server(host="127.0.0.1", port=DEFAULT_PORT, open_browser=True)
        return 0

    from jwt_inspector_guard.cli import main as cli_main

    return int(cli_main(args))


if __name__ == "__main__":
    raise SystemExit(main())
